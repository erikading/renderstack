# Backend URL (baked in at build time); use http://localhost:8000 for local development
VITE_SERVER_URL=http://localhost:8000

# Auth0 application
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# Auth0 database connection used for password reset emails (this is the default)
# VITE_AUTH0_CONNECTION=Username-Password-Authentication
