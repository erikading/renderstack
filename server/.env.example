# MongoDB Atlas connection string WITHOUT a database name or trailing slash
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Database name; use a different one per deployment if sharing a cluster (defaults to fake_so)
MONGODB_DB=renderstack

# URL of the deployed frontend (CORS + Auth0 baseURL)
CLIENT_URL=http://localhost:4530

# Auth0 application (issuer is the domain only, no https://)
AUTH0_CLIENT_ID=
AUTH0_ISSUER_BASE_URL=your-tenant.us.auth0.com
# Any long random string used to sign the session cookie, e.g. `openssl rand -hex 32`
AUTH0_SECRET=

# Cloudflare R2 object storage for uploaded media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
